:root {
  --accent: #ef6a45;
  --accent-soft: #fff0e9;
  --ink: #20212a;
  --muted: #777985;
  --bg: #eaf4ff;
  --card: #ffffff;
  --sidebar: #20212a;
  --line: #dfdfd7;
}

* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body {
  margin: 0;
  color: var(--ink);
  background: var(--bg);
  font-family: "DM Sans", sans-serif;
  transition: background .25s, color .25s;
}
body::before {
  content: "";
  position: fixed;
  z-index: -1;
  inset: 0 0 0 240px;
  pointer-events: none;
  background-image:
    linear-gradient(rgba(32,33,42,.035) 1px, transparent 1px),
    linear-gradient(90deg, rgba(32,33,42,.035) 1px, transparent 1px);
  background-size: 28px 28px;
  mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
}
a { color: inherit; }
.skip-link { position: fixed; z-index: 9999; top: -60px; left: 16px; padding: 10px 14px; background: var(--accent); color: #fff; }
.skip-link:focus { top: 0; }
.page-progress { position: fixed; z-index: 1000; top: 0; left: 0; right: 0; height: 3px; }
.page-progress span { display: block; width: 0; height: 100%; background: var(--accent); }

.sidebar {
  position: fixed;
  z-index: 100;
  inset: 0 auto 0 0;
  width: 240px;
  padding: 32px 28px;
  display: flex;
  flex-direction: column;
  background: var(--sidebar);
  color: #fff;
}
.brand { color: #fff; text-decoration: none; font: 800 28px "Manrope", sans-serif; }
.brand span { color: var(--accent); }
.nav-links { margin: auto 0; display: flex; flex-direction: column; gap: 7px; }
.nav-links a { display: flex; align-items: center; gap: 12px; padding: 11px 12px; border-radius: 8px; color: #afb1bb; text-decoration: none; font-size: 14px; transition: .2s; }
.nav-links a > span:first-child { color: #777985; font-size: 10px; }
.nav-links a:hover, .nav-links a.active { background: rgba(255,255,255,.08); color: #fff; transform: translateX(3px); }
.nav-links a.active > span:first-child { color: var(--accent); }
.sidebar-actions { display: flex; gap: 8px; }
.sidebar-actions { flex-wrap: wrap; }
.icon-button { width: 42px; height: 42px; border: 1px solid rgba(255,255,255,.12); border-radius: 50%; background: transparent; color: #fff; cursor: pointer; font-size: 11px; font-weight: 800; }
.nav-toggle { display: none; }

.main-content { margin-left: 240px; }
.resume-section { min-height: 100vh; display: flex; flex-direction: column; justify-content: center; padding: 70px clamp(38px,6vw,110px); border-bottom: 1px solid var(--line); }
.hero-section { flex-direction: row; align-items: center; gap: 5%; }
.hero-copy { flex: 1.05; max-width: 620px; }
.eyebrow, .section-kicker { margin: 0; color: var(--accent); text-transform: uppercase; font-size: 11px; font-weight: 700; letter-spacing: .16em; }
.eyebrow { display: flex; align-items: center; gap: 10px; }
.eyebrow span { width: 28px; height: 2px; background: var(--accent); }
.hero-copy h1 { margin: 18px 0 20px; font: 800 clamp(54px,6vw,88px)/.88 "Manrope", sans-serif; letter-spacing: -.07em; }
.hero-copy h1 em { display: block; color: var(--accent); font-style: normal; }
.hero-lead { max-width: 540px; margin: 0; color: var(--muted); font-size: 21px; line-height: 1.55; }
.hero-actions { display: flex; align-items: center; gap: 24px; margin-top: 28px; }
.primary-button { display: flex; align-items: center; gap: 22px; padding: 14px 16px 14px 20px; border-radius: 6px; background: var(--ink); color: #fff; text-decoration: none; font-weight: 700; box-shadow: 0 12px 28px rgba(32,33,42,.12); }
.primary-button b { width: 28px; height: 28px; display: grid; place-items: center; border-radius: 50%; background: var(--accent); }
.text-button { color: var(--ink); text-decoration: none; font-weight: 700; }
.text-button b { color: var(--accent); }
.contact-row { display: flex; gap: 28px; margin-top: 38px; padding-top: 16px; border-top: 1px solid var(--line); }
.contact-row div { display: grid; min-width: 0; }
.contact-row small { color: var(--muted); text-transform: uppercase; font-size: 9px; letter-spacing: .12em; }
.contact-row a { overflow-wrap: anywhere; text-decoration: none; font-size: 13px; font-weight: 700; }

.visual-grid { flex: .95; height: 530px; display: grid; grid-template-columns: 1.15fr .85fr; grid-template-rows: 1fr 1fr; gap: 14px; }
.visual-card { position: relative; margin: 0; overflow: hidden; border-radius: 20px; background: var(--card); box-shadow: 0 18px 50px rgba(32,33,42,.07); }
.visual-card img { width: 100%; height: 100%; object-fit: cover; transition: transform .5s; }
.visual-card:hover img { transform: scale(1.04); }
.code-card { grid-row: 1 / 3; }
.visual-card figcaption { position: absolute; left: 14px; right: 14px; bottom: 14px; display: grid; padding: 12px 14px; border-radius: 10px; background: rgba(255,255,255,.92); backdrop-filter: blur(8px); }
.visual-card figcaption span { color: var(--accent); font-size: 10px; }
.visual-card figcaption strong { margin-top: 2px; font-size: 14px; }
.network-card figcaption, .tools-card figcaption { padding: 8px 10px; }

.section-header { margin-bottom: 38px; }
.section-header h2 { margin: 7px 0 0; font: 800 clamp(44px,5vw,68px)/1 "Manrope", sans-serif; letter-spacing: -.06em; }
.experience-grid { display: grid; grid-template-columns: 1.25fr 1fr 1fr; gap: 16px; }
.experience-grid article { min-height: 390px; position: relative; overflow: hidden; border: 1px solid var(--line); border-radius: 18px; background: var(--card); }
.experience-grid article:not(.experience-featured) img { width: 100%; height: 210px; object-fit: cover; }
.experience-featured { background: var(--sidebar) !important; color: #fff; }
.experience-featured > img { position: absolute; right: -12%; bottom: -18%; width: 78%; height: 68%; opacity: .8; object-fit: cover; border-radius: 50%; }
.experience-index { position: absolute; z-index: 2; right: 18px; top: 12px; color: rgba(255,255,255,.12); font: 800 58px "Manrope", sans-serif; }
.experience-copy { position: relative; z-index: 2; padding: 18px 20px; }
.experience-featured .experience-copy { padding: 34px; }
.experience-copy time { color: var(--accent); text-transform: uppercase; font-size: 10px; letter-spacing: .1em; }
.experience-copy h3 { margin: 7px 0 5px; font: 800 20px "Manrope", sans-serif; }
.experience-copy p { margin: 0; color: var(--muted); line-height: 1.5; }
.experience-featured .experience-copy p { max-width: 70%; color: #bbbcca; }

.education-grid { display: grid; grid-template-columns: 1.35fr 1fr; gap: 16px; }
.education-grid article { min-height: 300px; position: relative; overflow: hidden; border: 1px solid var(--line); border-radius: 18px; background: var(--card); }
.education-main { background: var(--sidebar) !important; color: #fff; }
.education-grid img { position: absolute; right: -6%; bottom: -24%; width: 72%; height: 82%; object-fit: cover; }
.education-side img { right: -18%; bottom: -28%; width: 82%; height: 78%; opacity: .95; }
.education-number { position: absolute; z-index: 2; right: 18px; top: 10px; color: var(--line); font: 800 52px "Manrope", sans-serif; }
.education-main .education-number { color: rgba(255,255,255,.12); }
.education-copy { position: absolute; z-index: 3; left: 28px; top: 30px; max-width: 64%; }
.education-copy time { color: var(--accent); text-transform: uppercase; font-size: 10px; letter-spacing: .1em; }
.education-copy h3 { margin: 8px 0 4px; font: 800 22px "Manrope", sans-serif; }
.education-copy p { margin: 0; color: var(--muted); }
.education-main .education-copy p { color: #bbbcca; }

.skills-grid { display: grid; grid-template-columns: repeat(4,1fr); gap: 14px; }
.skills-grid article { min-height: 300px; position: relative; overflow: hidden; border: 1px solid var(--line); border-radius: 18px; background: var(--card); }
.skills-grid article > span { position: absolute; z-index: 3; left: 14px; top: 12px; color: var(--accent); font-weight: 800; }
.skills-grid img { width: 100%; height: 100%; object-fit: cover; }
.skills-grid h3 { position: absolute; z-index: 2; left: 14px; right: 14px; bottom: 12px; margin: 0; padding: 12px; border-radius: 9px; background: rgba(255,255,255,.92); font: 800 16px "Manrope", sans-serif; }

.interests-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 14px; }
.interests-grid article { min-height: 270px; position: relative; overflow: hidden; margin: 0; border: 1px solid var(--line); border-radius: 18px; background: var(--card); }
.interests-grid img { width: 100%; height: 100%; object-fit: cover; }
.interests-grid div { position: absolute; z-index: 2; left: 14px; right: 14px; bottom: 14px; display: flex; align-items: center; gap: 10px; padding: 12px; border-radius: 9px; background: rgba(255,255,255,.92); }
.interests-grid div span { color: var(--accent); font-weight: 800; }
.interests-grid h3 { margin: 0; font: 800 16px "Manrope", sans-serif; }

body.theme-dark { --bg:#17181e; --card:#20212a; --ink:#f5f4ef; --muted:#b2b3bd; --line:#343640; --accent-soft:#392820; --sidebar:#111216; }
body.theme-dark::before { background-image: linear-gradient(rgba(255,255,255,.025) 1px, transparent 1px), linear-gradient(90deg,rgba(255,255,255,.025) 1px,transparent 1px); }

@media (max-width:1100px) {
  .sidebar { width:190px; padding:24px 18px; }
  .main-content { margin-left:190px; }
  body::before { left:190px; }
  .resume-section { padding:60px 36px; }
  .hero-copy h1 { font-size:60px; }
  .visual-grid { height:470px; }
  .experience-grid { grid-template-columns:1fr 1fr; }
  .experience-featured { grid-column:1 / 3; }
}
@media (max-width:820px) {
  .sidebar { width:100%; height:72px; inset:0 0 auto 0; flex-direction:row; align-items:center; padding:12px 18px; }
  .nav-toggle { width:42px; height:42px; margin-left:auto; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:5px; border:0; background:transparent; }
  .nav-toggle span { width:22px; height:2px; background:#fff; }
  .nav-links { display:none; position:absolute; left:12px; right:12px; top:66px; margin:0; padding:12px; border-radius:12px; background:var(--sidebar); }
  .sidebar.nav-open .nav-links { display:flex; }
  .sidebar-actions { margin-left:8px; }
  .print-button { display:none; }
  .main-content { margin-left:0; padding-top:72px; }
  body::before { inset:72px 0 0; }
  .resume-section { min-height:auto; padding:60px 22px; }
  .hero-section { flex-direction:column; align-items:stretch; }
  .hero-copy h1 { font-size:clamp(48px,15vw,72px); }
  .visual-grid { width:100%; height:430px; margin-top:28px; }
  .education-grid,.interests-grid { grid-template-columns:1fr; }
  .skills-grid { grid-template-columns:repeat(2,1fr); }
}
@media (max-width:520px) {
  .hero-actions,.contact-row { align-items:flex-start; flex-direction:column; }
  .contact-row { gap:12px; }
  .visual-grid { height:350px; grid-template-columns:1fr 1fr; }
  .experience-grid,.skills-grid { grid-template-columns:1fr; }
  .experience-featured { grid-column:auto; }
  .experience-grid article { min-height:330px; }
  .education-grid article { min-height:260px; }
  .education-grid img { bottom:-32%; height:68%; opacity:.75; }
  .education-copy { left:20px; top:20px; max-width:68%; }
  .skills-grid article { min-height:260px; }
}
@media print {
  .sidebar,.page-progress,.hero-actions,.sidebar-actions { display:none!important; }
  .main-content { margin:0; }
  body::before { display:none; }
  .resume-section { min-height:auto; break-inside:avoid; padding:35px 40px; }
}
